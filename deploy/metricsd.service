[Unit]
Description=metricsd system metrics collector
Documentation=https://github.com/brian-nunez/metricsd

[Service]
Type=exec
ExecStart=@BINDIR@/metricsd
Restart=on-failure
RestartSec=5s

# Creates ~/.local/state/metricsd and $XDG_RUNTIME_DIR/metricsd, writable
# even though the rest of the filesystem is read-only below.
StateDirectory=metricsd
RuntimeDirectory=metricsd

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX serves the local API; AF_INET/AF_INET6 are for OTLP export.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=default.target
